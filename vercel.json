{
  "version": 2,
  "buildCommand": "echo 'no build step required'",
  "outputDirectory": ".",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    },
    "api/ai.js": {
      "maxDuration": 30
    },
    "api/agent.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/auth/(.*)",                "destination": "/api/auth" },
    { "source": "/api/users/(.*)",               "destination": "/api/users" },
    { "source": "/api/assets",                   "destination": "/api/assets" },
    { "source": "/api/audit",                    "destination": "/api/audit" },
    { "source": "/api/admin/dealers/(.*)",      "destination": "/api/dealers" },
    { "source": "/api/admin/dealers",           "destination": "/api/dealers" },
    { "source": "/api/dealer/(.*)",             "destination": "/api/dealers" },
    { "source": "/api/vehicles/([^/]+)/dealer-matches",  "destination": "/api/dealers" },
    { "source": "/api/vehicles/([^/]+)/service-requests", "destination": "/api/dealers" },
    { "source": "/api/vehicles/([^/]+)/history", "destination": "/api/vehicles" },
    { "source": "/api/vehicles/([^/]+)/status",  "destination": "/api/vehicles" },
    { "source": "/api/vehicles/([^/]+)",          "destination": "/api/vehicles" },
    { "source": "/api/history/(.*)",             "destination": "/api/history" },
    { "source": "/api/reminders/([^/]+)",         "destination": "/api/reminders" },
    { "source": "/api/trips/([^/]+)",             "destination": "/api/trips" },
    { "source": "/api/profile/(.*)",              "destination": "/api/profile" }
  ]
}
