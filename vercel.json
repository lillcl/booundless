{
  "version": 2,
  "buildCommand": "echo 'no build step required'",
  "outputDirectory": ".",
  "functions": {
    "api/ai.js": {
      "maxDuration": 30
    },
    "api/agent.js": {
      "maxDuration": 60
    },
    "api/index.js": {
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "/api/ai/?", "dest": "/api/ai" },
    { "src": "/api/agent/?", "dest": "/api/agent" },
    { "src": "/api/(.*)", "dest": "/api/index" },
    { "src": "/demo/?", "dest": "/index.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
