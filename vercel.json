{
  "version": 2,
  "buildCommand": "echo 'no build step required'",
  "outputDirectory": ".",
  "functions": {
    "api/ai.js": {
      "maxDuration": 30
    },
    "api/agent.js": {
      "maxDuration": 60
    },
    "api/index.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/ai", "destination": "/api/ai" },
    { "source": "/api/agent", "destination": "/api/agent" },
    { "source": "/api/(.*)", "destination": "/api/index" }
  ]
}
