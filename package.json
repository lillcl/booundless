{
  "name": "kc-carai",
  "version": "0.1.0",
  "private": true,
  "description": "康程 CarAI — Service V10 web app. Vanilla HTML/CSS/JS frontend, serverless API, Postgres persistence.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev-server.js",
