# Local Postgres connection. Override with KC_DATABASE_URL in production.
# Format: postgres://user:password@host:port/database
KC_DATABASE_URL=postgresql://kc_app:kc_dev_password@127.0.0.1:5432/kc_carai

# Port for the local dev server. Defaults to 3000 when unset.
PORT=3000

# ── Supabase (optional cloud Postgres + auth + storage + realtime) ──
# Use these to point the app at a Supabase project instead of the local
# Postgres above. Both can coexist: set SUPABASE_DB_URL when you want
# serverless API calls to talk to Supabase; leave it blank to use the
# local KC_DATABASE_URL.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=
SUPABASE_STORAGE_BUCKET=cars

# ── AI provider: MiniMax ──
# Set AI_API_KEY to enable AI features. The defaults below point at
# MiniMax's OpenAI-compatible endpoint, so the standard openai SDK or
# any fetch() against /v1/chat/completions works out of the box.
#
# MiniMax reference:
#   https://intl.minimaxi.com/docs/api-reference/text-openai-api
#   https://intl.minimaxi.com/docs/api-reference/text-chat
AI_API_KEY=
AI_BASE_URL=https://api.minimax.io/v1
AI_MODEL=MiniMax-M3
AI_VISION_MODEL=MiniMax-M3
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1024
AI_TIMEOUT_MS=15000
