/* app.wxss — 全局样式与设计 token */

page {
  --bg: #f5f3ef;
  --card: #ffffff;
  --ink: #1a2233;
  --muted: #5b6675;
  --line: #e5e0d6;
  --soft: #f5f3ef;
  --brand: #073568;
  --brand-soft: #e8edf4;
  --green: #1f7a5a;
  --green-bg: #e6f4ec;
  --amber: #b8730e;
  --amber-bg: #fbeed8;
  --red: #a83a3a;
  --red-bg: #f6e1e1;
  --radius: 22rpx;
  --shadow: 0 6rpx 24rpx rgba(7, 53, 104, 0.06);
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, "PingFang HK", "PingFang TC", "Noto Sans HK", "Microsoft JhengHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.kc-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.kc-page--with-tabbar {
  padding-bottom: 140rpx;
}

.kc-card {
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 32rpx;
  margin: 24rpx;
}

.kc-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.kc-stack {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.kc-muted { color: var(--muted); }
.kc-ink { color: var(--ink); }
.kc-brand { color: var(--brand); }
.kc-amber { color: var(--amber); }
.kc-red { color: var(--red); }
.kc-green { color: var(--green); }

.kc-h1 { font-size: 44rpx; font-weight: 700; line-height: 1.3; }
.kc-h2 { font-size: 36rpx; font-weight: 600; }
.kc-h3 { font-size: 30rpx; font-weight: 600; }
.kc-body { font-size: 28rpx; }
.kc-small { font-size: 24rpx; color: var(--muted); }
.kc-tiny { font-size: 22rpx; color: var(--muted); }

.kc-divider {
  height: 1rpx;
  background: var(--line);
  margin: 24rpx 0;
}

.kc-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 40rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  line-height: 1;
}

.kc-button--primary {
  background: var(--brand);
  color: #fff;
}

.kc-button--primary[disabled] {
  background: #b6c2d4;
  color: #fff;
}

.kc-button--secondary {
  background: var(--brand-soft);
  color: var(--brand);
}

.kc-button--ghost {
  background: transparent;
  color: var(--muted);
  border: 1rpx solid var(--line);
}

.kc-button--danger {
  background: var(--red-bg);
  color: var(--red);
}

.kc-button--block {
  display: flex;
  width: calc(100% - 96rpx);
  margin: 24rpx 48rpx;
  box-sizing: border-box;
}

.kc-input {
  background: var(--soft);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.kc-textarea {
  background: var(--soft);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
}

.kc-list {
  background: var(--card);
  margin: 24rpx;
  border-radius: var(--radius);
  overflow: hidden;
}

.kc-list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--line);
  background: var(--card);
}

.kc-list-item:last-child { border-bottom: none; }

.kc-list-item__title { font-size: 30rpx; color: var(--ink); }
.kc-list-item__hint { font-size: 24rpx; color: var(--muted); }
.kc-list-item__arrow { color: var(--muted); font-size: 28rpx; }

.kc-pill {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.kc-pill--brand { background: var(--brand-soft); color: var(--brand); }
.kc-pill--green { background: var(--green-bg); color: var(--green); }
.kc-pill--amber { background: var(--amber-bg); color: var(--amber); }
.kc-pill--red { background: var(--red-bg); color: var(--red); }
.kc-pill--muted { background: var(--soft); color: var(--muted); }

.kc-form-field {
  margin-bottom: 24rpx;
}

.kc-form-field__label {
  font-size: 26rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
  display: block;
}

.kc-status {
  margin: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  background: var(--brand-soft);
  color: var(--brand);
}

.kc-status--error {
  background: var(--red-bg);
  color: var(--red);
}

.kc-status--ok {
  background: var(--green-bg);
  color: var(--green);
}

.kc-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  color: var(--muted);
}

.kc-empty__icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

.kc-empty__title {
  font-size: 30rpx;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.kc-empty__hint {
  font-size: 24rpx;
  text-align: center;
  max-width: 480rpx;
  line-height: 1.5;
}