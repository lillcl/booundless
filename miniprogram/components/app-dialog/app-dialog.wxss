.kc-app-dialog__mask {
  position: fixed;
  inset: 0;
  background: rgba(7, 53, 104, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.kc-app-dialog {
  width: 560rpx;
  background: var(--card);
  border-radius: 24rpx;
  padding: 40rpx 40rpx 28rpx;
  box-shadow: 0 24rpx 48rpx rgba(7, 53, 104, 0.18);
}

.kc-app-dialog__title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: var(--ink);
}

.kc-app-dialog__body {
  font-size: 28rpx;
  color: var(--ink);
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.kc-app-dialog__input {
  background: var(--soft);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.kc-app-dialog__actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.kc-app-dialog__btn {
  padding: 18rpx 32rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.kc-app-dialog__btn--ghost {
  background: transparent;
  color: var(--muted);
}

.kc-app-dialog__btn--primary {
  background: var(--brand);
  color: #fff;
}