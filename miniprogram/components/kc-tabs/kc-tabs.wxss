.kc-tabs {
  display: flex;
  gap: 24rpx;
  padding: 16rpx 24rpx;
  background: var(--card);
  border-radius: 20rpx;
  box-shadow: var(--shadow);
  margin: 24rpx;
}

.kc-tabs__item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--muted);
  border-radius: 12rpx;
  font-weight: 600;
}

.kc-tabs__item--active {
  background: var(--brand-soft);
  color: var(--brand);
}