.kc-landing {
  min-height: 100vh;
  padding: 88rpx 40rpx 56rpx;
  box-sizing: border-box;
  background: var(--bg);
  color: var(--ink);
}

.kc-landing__intro {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0 8rpx 40rpx;
}

.kc-landing__eyebrow {
  margin-bottom: 20rpx;
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 600;
}

.kc-landing__title {
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.3;
}

.kc-landing__description {
  margin-top: 16rpx;
  color: var(--muted);
  font-size: 28rpx;
  line-height: 1.6;
}

.kc-landing__features {
  overflow: hidden;
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
  background: var(--card);
}

.kc-landing__feature {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid var(--line);
}

.kc-landing__feature:last-child {
  border-bottom: 0;
}

.kc-landing__feature-title {
  font-size: 28rpx;
  font-weight: 600;
}

.kc-landing__feature-hint {
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.kc-landing__cta {
  margin-top: 32rpx;
}

.kc-landing__footer {
  display: block;
  margin: 36rpx 8rpx 0;
  color: var(--muted);
  font-size: 22rpx;
  text-align: center;
}
