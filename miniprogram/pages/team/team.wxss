.kc-team { padding: 24rpx; }

.kc-team__head { margin: 0 8rpx 24rpx; }

.kc-team__title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
}

.kc-team__sub {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

.kc-team__list { display: flex; flex-direction: column; gap: 16rpx; }

.kc-team__item {
  background: var(--card);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: var(--shadow);
}

.kc-team__item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.kc-team__item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.kc-team__item-role {
  padding: 6rpx 16rpx;
  background: var(--brand-soft);
  color: var(--brand);
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.kc-team__item-meta {
  font-size: 22rpx;
  color: var(--muted);
}