.kc-qinao { padding: 24rpx; }

.kc-qinao__head { margin: 0 8rpx 24rpx; }

.kc-qinao__title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
}

.kc-qinao__sub {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

.kc-qinao__card {
  background: var(--card);
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

.kc-qinao__img {
  width: 100%;
  height: 320rpx;
  background: var(--soft);
}

.kc-qinao__body { padding: 24rpx; }

.kc-qinao__name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 6rpx;
}

.kc-qinao__route {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}

.kc-qinao__meta {
  font-size: 24rpx;
  color: var(--brand);
  font-weight: 600;
}

.kc-qinao__tips {
  background: var(--card);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: var(--shadow);
  margin-bottom: 24rpx;
}

.kc-qinao__tips-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.kc-qinao__tip {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.kc-qinao__tip:last-child { border-bottom: none; }

.kc-qinao__tip-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.kc-qinao__tip-body { flex: 1; }

.kc-qinao__tip-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.kc-qinao__tip-text {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.5;
}

.kc-qinao__ai {
  background: linear-gradient(135deg, var(--brand) 0%, #0c4880 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  color: #fff;
  box-shadow: var(--shadow);
}

.kc-qinao__ai-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.kc-qinao__ai-text {
  font-size: 24rpx;
  opacity: 0.85;
  margin-bottom: 20rpx;
}

.kc-qinao__ai-btn {
  display: inline-block;
  padding: 16rpx 32rpx;
  background: #fff;
  color: var(--brand);
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
}