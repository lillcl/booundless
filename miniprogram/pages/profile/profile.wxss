.kc-profile { padding: 24rpx; }

.kc-profile__user {
  display: flex;
  gap: 20rpx;
  align-items: center;
  background: linear-gradient(135deg, var(--brand) 0%, #0c4880 100%);
  color: #fff;
  padding: 32rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

.kc-profile__avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--soft);
  border: 4rpx solid rgba(255,255,255,0.3);
}

.kc-profile__user-body { flex: 1; }

.kc-profile__name {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.kc-profile__email {
  font-size: 24rpx;
  opacity: 0.85;
  margin-bottom: 4rpx;
}

.kc-profile__role {
  display: inline-block;
  padding: 4rpx 12rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 999rpx;
  font-size: 22rpx;
  margin-top: 4rpx;
}

.kc-profile__logout {
  margin: 32rpx 24rpx;
  text-align: center;
  color: var(--red);
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx;
  background: var(--card);
  border-radius: 16rpx;
  box-shadow: var(--shadow);
}