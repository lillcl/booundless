.kc-404 {
  min-height: 100vh;
  background: var(--brand);
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.kc-404__hero { text-align: center; margin-bottom: 64rpx; }

.kc-404__logo {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.16);
  padding: 24rpx;
}

.kc-404__title {
  font-size: 96rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  margin-bottom: 16rpx;
}

.kc-404__sub {
  font-size: 32rpx;
  opacity: 0.85;
}

.kc-404__action {
  padding: 24rpx 64rpx;
  background: #fff;
  color: var(--brand);
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}