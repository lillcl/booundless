.kc-service { padding: 24rpx; }

.kc-service__head { margin: 0 8rpx 24rpx; }

.kc-service__title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
}

.kc-service__sub {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

.kc-service__cars {
  background: var(--card);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

.kc-service__cars-title {
  font-size: 26rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}

.kc-picker {
  display: flex;
  align-items: center;
  min-height: 80rpx;
}

.kc-service__grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.kc-service__card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: var(--shadow);
}

.kc-service__card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand);
  margin-bottom: 16rpx;
}

.kc-service__items {
  display: flex;
  flex-direction: column;
}

.kc-service__item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.kc-service__item:last-child { border-bottom: none; }

.kc-service__item-name {
  font-size: 28rpx;
  color: var(--ink);
}

.kc-service__item-arrow {
  color: var(--muted);
  font-size: 28rpx;
}