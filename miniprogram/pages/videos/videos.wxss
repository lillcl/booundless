.kc-videos { padding: 24rpx; }

.kc-videos__head { margin: 0 8rpx 24rpx; }

.kc-videos__title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
}

.kc-videos__sub {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

.kc-videos__list { display: flex; flex-direction: column; gap: 16rpx; }

.kc-videos__item {
  display: flex;
  gap: 16rpx;
  background: var(--card);
  border-radius: 20rpx;
  padding: 16rpx;
  box-shadow: var(--shadow);
}

.kc-videos__thumb {
  width: 220rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: var(--soft);
  flex-shrink: 0;
}

.kc-videos__body { flex: 1; min-width: 0; }

.kc-videos__title-row {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.kc-videos__desc {
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.kc-videos__meta { font-size: 22rpx; color: var(--brand); }