.kc-about { padding: 24rpx; }

.kc-about__hero {
  text-align: center;
  padding: 48rpx 24rpx;
  background: linear-gradient(135deg, var(--brand) 0%, #0c4880 100%);
  color: #fff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

.kc-about__logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 16rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  padding: 16rpx;
}

.kc-about__brand {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.kc-about__sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-bottom: 8rpx;
}

.kc-about__version {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 999rpx;
  font-size: 22rpx;
}

.kc-card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.kc-about__paragraph {
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.7;
}

.kc-about__credit {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 16rpx;
}

.kc-about__credit-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 24rpx;
}

.kc-about__credit-item:last-child { border-bottom: none; }

.kc-about__credit-name { color: var(--ink); }
.kc-about__credit-licence { color: var(--muted); font-size: 22rpx; }

.kc-about__footer {
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 32rpx;
  margin-bottom: 24rpx;
}