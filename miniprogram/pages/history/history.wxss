.kc-history { padding: 24rpx; }

.kc-history__head { margin: 0 8rpx 24rpx; }

.kc-history__title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
}

.kc-history__sub {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

.kc-history__list { display: flex; flex-direction: column; gap: 16rpx; }

.kc-history__item {
  background: var(--card);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: var(--shadow);
}

.kc-history__item-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.kc-history__item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.kc-history__item-date {
  font-size: 22rpx;
  color: var(--muted);
}

.kc-history__item-meta {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 6rpx;
}

.kc-history__item-notes {
  font-size: 24rpx;
  color: var(--ink);
  margin-top: 8rpx;
}