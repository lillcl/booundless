.kc-chat {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--soft);
}

.kc-chat__scroll {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.kc-chat__messages {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.kc-chat__row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.kc-chat__row--user { flex-direction: row-reverse; }

.kc-chat__avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
  box-shadow: var(--shadow);
}

.kc-chat__bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: var(--card);
  box-shadow: var(--shadow);
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--ink);
}

.kc-chat__bubble--user {
  background: var(--brand);
  color: #fff;
}

.kc-chat__bubble--bot {
  background: var(--card);
  color: var(--ink);
}

.kc-chat__tool {
  font-size: 22rpx;
  color: var(--brand);
  font-weight: 600;
}

.kc-chat__text { white-space: pre-wrap; word-break: break-word; }

.kc-chat__typing { display: inline-flex; gap: 8rpx; }
.kc-chat__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--muted);
  opacity: 0.5;
  animation: kc-blink 1.2s infinite;
}
.kc-chat__dot:nth-child(2) { animation-delay: 0.2s; }
.kc-chat__dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes kc-blink {
  0%, 60%, 100% { opacity: 0.3; }
  30% { opacity: 1; }
}

.kc-chat__composer {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: var(--card);
  border-top: 1rpx solid var(--line);
}

.kc-chat__input {
  flex: 1;
  background: var(--soft);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  min-height: 60rpx;
  max-height: 200rpx;
  box-sizing: border-box;
}

.kc-chat__send {
  background: var(--brand);
  color: #fff;
  padding: 18rpx 28rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.kc-chat__send--disabled { background: var(--muted); }