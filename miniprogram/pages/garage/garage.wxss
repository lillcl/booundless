.kc-garage { padding: 24rpx; }

.kc-garage__head {
  margin: 0 8rpx 24rpx;
}

.kc-garage__title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
}

.kc-garage__sub {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

.kc-garage__list { padding: 0; }

.kc-garage__empty { padding: 24rpx; }

.kc-garage__fab {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  background: var(--brand);
  color: #fff;
  padding: 24rpx 32rpx;
  border-radius: 999rpx;
  box-shadow: 0 12rpx 32rpx rgba(7, 53, 104, 0.32);
  font-size: 28rpx;
  font-weight: 600;
  z-index: 100;
}

.kc-picker { display: flex; align-items: center; min-height: 80rpx; }

.kc-garage__photo {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.kc-garage__photo-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: var(--soft);
}

.kc-garage__photo-placeholder {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: var(--soft);
  border: 2rpx dashed var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--muted);
}

.kc-garage__photo-clear {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 24rpx;
}

.kc-garage__form-actions { margin-top: 16rpx; }