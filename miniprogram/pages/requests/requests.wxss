.kc-requests { padding: 24rpx; }

.kc-requests__head { margin: 0 8rpx 24rpx; }

.kc-requests__title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
}

.kc-requests__sub {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

.kc-requests__tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.kc-requests__tab {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: var(--card);
  color: var(--muted);
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: var(--shadow);
}

.kc-requests__tab--active {
  background: var(--brand);
  color: #fff;
}

.kc-requests__list { display: flex; flex-direction: column; gap: 16rpx; }

.kc-requests__item {
  background: var(--card);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: var(--shadow);
}

.kc-requests__item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.kc-requests__item-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.kc-requests__item-sub {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 6rpx;
}

.kc-requests__item-meta {
  font-size: 22rpx;
  color: var(--brand);
}