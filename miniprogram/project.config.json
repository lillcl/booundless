{
  "description": "项目配置文件",
  "packOptions": {
    "ignore": [
      { "type": "file", "value": ".eslintrc.js" },
      { "type": "file", "value": ".gitignore" },
      { "type": "file", "value": "project.private.config.json" },
      { "type": "file", "value": "README.md" },
      { "type": "folder", "value": "server-patch" }
